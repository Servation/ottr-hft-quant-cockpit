# OTTR secrets. Copy to ottr/.env (gitignored). Real environment variables win over this file.

# Discord channel webhook for meetings, fills, risk events and alarms. Leave empty to log only.
DISCORD_WEBHOOK_URL=

# Enables POST /api/kill-switch. 16+ characters, e.g. the output of:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OTTR_API_KEY=

# Discord chat bot (`ottr chat`; setup in README.md). It runs only when both are set.
# Bot token: Developer Portal > your app > Bot > Reset Token.
DISCORD_BOT_TOKEN=
# Your Discord user ID (Developer Mode, right-click your name > Copy User ID): the owner.
CEO_DISCORD_ID=
# Optional: other user IDs, comma-separated, that may read, /ask and /kill (not /release).
OTTR_CHAT_ALLOWED_IDS=
# Optional: one server ID to register the commands in (they appear there immediately).
DISCORD_GUILD_ID=

# Alpaca (US desk, market data only: OTTR never sends orders). A free paper account is
# enough: Alpaca dashboard > Paper Trading > API Keys. The key ID starts with PK.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
